{
  "name": "jsbrains",
  "version": "1.0.2",
  "description": "A collection of smart modules for building brains in JavaScript.",
  "repository": {
    "type": "git",
    "url": "brianpetro/jsbrains"
  },
  "keywords": [
    "ai",
    "chat",
    "models",
    "embeddings",
    "framework"
  ],
  "author": "Brian Joseph Petro (🌴 Brian)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brianpetro/jsbrains/issues"
  },
  "homepage": "https://jsbrains.org",
  "scripts": {
    "build:smart-types-declarations": "tsc -p smart-types/tsconfig.json",
    "prepare": "npm run build:smart-types-declarations"
  },
  "exports": {
    "./smart-types": {
      "types": "./smart-types/dist/index.d.ts",
      "import": "./smart-types/index.js",
      "default": "./smart-types/index.js"
    }
  },
  "devDependencies": {
    "jsdoc": "^4.0.2",
    "smart-types": "*",
    "typescript": "^5.9.0"
  },
  "private": true,
  "workspaces": [
    "smart-blocks",
    "smart-chat-model",
    "smart-cluster-groups",
    "smart-clusters",
    "smart-collections",
    "smart-contexts",
    "smart-directories",
    "smart-embed-model",
    "smart-entities",
    "smart-environment",
    "smart-events",
    "smart-fs",
    "smart-file-system",
    "smart-groups",
    "smart-http-request",
    "smart-model",
    "smart-models",
    "smart-notices",
    "smart-rank-model",
    "smart-settings",
    "smart-sources",
    "smart-types",
    "smart-utils",
    "smart-view"
  ]
}
